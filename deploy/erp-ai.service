[Unit]
Description=ERP AI FastAPI service
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/erp_ai
EnvironmentFile=/var/www/erp_ai/.env
ExecStart=/var/www/erp_ai/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
