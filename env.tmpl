#remove the .tml and save it as ".env" file


AI_PROVIDER=openai
AI_MODEL=gpt-4o
OPENAI_API_KEY= 
ERP_URL=http://127.0.0.1:8000
ERP_API_KEY=
ERP_API_SECRET=
ENVIRONMENT=development #use development to see the generated SQL section and use production to hide it in prod server.
SALES_INVOICE_FOLLOWUP_GUARDRAIL_CLIENTS= # comma-separated client IDs that should keep invoice-level follow-up/grand-total guardrails enabled
# PostgreSQL example for production:
# DATABASE_URL=postgresql+psycopg://erp_ai_user:strong_password@127.0.0.1:5432/erp_ai

# Motherbrain Telemetry Settings
# Point this to the Motherbrain Admin backend base URL (NOT the full /ingest path).
# The erp_ai service will append /api/motherbrain/ingest automatically.
MOTHERBRAIN_URL=http://127.0.0.1:8001
MOTHERBRAIN_API_KEY=dev_motherbrain_key_123

# Autonomous Learning Settings
# Set to "true" to auto-approve AI-extracted context overrides without admin review.
# Leave as "false" (default) to use the Pending Overrides queue in Motherbrain.
AUTO_APPROVE_OVERRIDES=false
